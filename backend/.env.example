# =============================================================
# PaintMatch — Variables d'environnement (exemple)
# Copier ce fichier en .env et renseigner les valeurs
# =============================================================

SECRET_KEY=django-insecure-remplacer-par-une-cle-secrete-forte
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (SQLite par défaut, remplacer pour PostgreSQL)
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/paintmatch

DEFAULT_FROM_EMAIL=no-reply@paintmatch.cm
SERVER_EMAIL=no-reply@paintmatch.cm

# SMTP (production uniquement)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre@email.cm
# EMAIL_HOST_PASSWORD=mot-de-passe-app

# CORS (domaines frontend autorisés)
CORS_ALLOWED_ORIGINS=http://localhost:3000
